{
  "name": "trading-chest",
  "version": "0.5.3",
  "description": "Professional trading chart for EvoTrader, based on KLineChart.",
  "type": "module",
  "main": "./dist/trading-chest.umd.js",
  "module": "./dist/trading-chest.js",
  "types": "./dist/index.d.ts",
  "files": [
    "LICENSE",
    "README.md",
    "dist/"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/evotrader/TradingChest"
  },
  "keywords": [
    "trading",
    "chart",
    "klinecharts",
    "candlestick",
    "finance",
    "quantitative",
    "canvas"
  ],
  "author": "EvoTrader",
  "license": "Apache-2.0",
  "scripts": {
    "build-core": "tsc && vite build",
    "build-dts": "dts-bundle-generator --no-banner true --umd-module-name klinechartspro --external-imports solid-js klinecharts -o dist/index.d.ts src/index.ts",
    "build": "pnpm build-core && pnpm build-dts",
    "lint": "eslint --ext .ts,.tsx src",
    "lint:fix": "eslint --ext .ts,.tsx src --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "find-dead-code": "ts-prune src",
    "find-dead-code:strict": "ts-prune src --ignore 'node_modules|__tests__|\\.d\\.ts' | Select-String -NotMatch '(used in module)'",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:deploy": "pnpm run docs:build && gh-pages -d website"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "^6.9.1",
    "dts-bundle-generator": "^9.5.1",
    "eslint": "^10.7.0",
    "eslint-plugin-n": "^18.2.2",
    "eslint-plugin-promise": "^7.3.0",
    "gh-pages": "^6.3.0",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "klinecharts": "10.0.0",
    "ts-prune": "^0.10.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.4",
    "vite-plugin-solid": "^2.11.12",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "solid-js": "^1.9.14"
  },
  "peerDependencies": {
    "klinecharts": "10.0.0"
  }
}
